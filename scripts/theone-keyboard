#!/bin/sh
# Switch the on-screen keyboard between theOne and the stock Sailfish keyboard.
# Run as the normal user (defaultuser), not as root:
#     theone-keyboard on | off | status
#     theone-keyboard style classic | sailfish
#     theone-keyboard keys standard | wide
#     theone-keyboard debug on | off     (log what the keyboard sees to the journal)
set -u
# dconf needs the session bus, which an SSH login doesn't set up.
[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] || export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/dbus/user_bus_socket"
CONF="$HOME/.config/maliit.org/server.conf"
BACKUP="$CONF.before-theone"

if [ "$(id -u)" = 0 ]; then
    echo "Run this as your normal user, not as root (no devel-su)." >&2
    exit 1
fi

restart() {
    systemctl --user restart maliit-server.service 2>/dev/null || {
        killall maliit-server 2>/dev/null
        true
    }
}

case "${1:-status}" in
on)
    mkdir -p "$(dirname "$CONF")"
    if [ -f "$CONF" ] && ! grep -q 'theone.qml' "$CONF"; then
        cp "$CONF" "$BACKUP"
    fi
    printf '[maliit]\nonscreen\\active=theone.qml\nonscreen\\enabled=theone.qml, jolla-keyboard.qml\n' > "$CONF"
    restart
    echo "theOne keyboard is on. Undo with: theone-keyboard off"
    ;;
off)
    if [ -f "$BACKUP" ]; then
        mv -f "$BACKUP" "$CONF"
    else
        rm -f "$CONF"
    fi
    restart
    echo "Stock Sailfish keyboard restored."
    ;;
status)
    if [ -f "$CONF" ] && grep -q 'active=theone.qml' "$CONF"; then
        echo "on"
    else
        echo "off"
    fi
    ;;
style|ambience)
    KEY=/apps/theone-keyboard/ambience
    case "${2:-}" in
    classic|iphone|ios|off) dconf write "$KEY" "'off'" && echo "Style: theOne Classic" ;;
    sailfish|silica) dconf write "$KEY" "'silica'" && echo "Style: Sailfish" ;;
    "")
        v=$(dconf read "$KEY" 2>/dev/null | tr -d "'")
        [ "$v" = silica ] && echo sailfish || echo classic
        ;;
    *)
        echo "usage: theone-keyboard style classic|sailfish" >&2
        echo "  classic   theOne Classic: dark rounded keys on a solid background (default)" >&2
        echo "  sailfish  see-through glass keys in the ambience's colours and font" >&2
        exit 2
        ;;
    esac
    ;;
keys)
    KEY=/apps/theone-keyboard/wide-keys
    case "${2:-}" in
    standard) dconf write "$KEY" false && echo "Key size: standard" ;;
    wide) dconf write "$KEY" true && echo "Key size: wide" ;;
    "") [ "$(dconf read "$KEY" 2>/dev/null)" = true ] && echo wide || echo standard ;;
    *) echo "usage: theone-keyboard keys standard|wide" >&2; exit 2 ;;
    esac
    ;;
debug)
    case "${2:-}" in
    on) dconf write /apps/theone-keyboard/debug true && echo "theOne logging is on (journalctl)." ;;
    off) dconf write /apps/theone-keyboard/debug false && echo "theOne logging is off." ;;
    *) echo "usage: theone-keyboard debug on|off" >&2; exit 2 ;;
    esac
    ;;
*)
    echo "usage: theone-keyboard on|off|status|style [classic|sailfish]|keys [standard|wide]|debug [on|off]" >&2
    exit 2
    ;;
esac
